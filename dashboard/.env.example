# Kopieren nach ".env" und anpassen. Nach Änderungen "npm run dev" neu starten.

# mock    = simulierte KI (läuft ohne Backend)
# backend = euer Gruppen-Backend (Endpunkte siehe API.md)
VITE_AI_MODE=backend

# Variante A (empfohlen): Vite-Proxy – Frontend ruft /api/... auf,
# Vite leitet an euer Backend weiter. Dann kein CORS nötig.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=

# Variante B: Backend direkt ansprechen (Backend muss CORS erlauben)
# VITE_API_BASE_URL=http://localhost:8000

# Bei Backend-Fehlern automatisch auf Simulation ausweichen (gut für die Live-Demo)
VITE_AI_FALLBACK=true

# Timeout pro Anfrage (ms) – LLM-Antworten können dauern
VITE_API_TIMEOUT_MS=120000
