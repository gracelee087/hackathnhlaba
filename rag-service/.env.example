# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HIP_API_KEY=
# Embedding backend: local (MiniLM, offline) | google (gemini-embedding-2, needs GOOGLE_API_KEY) | hip (JAIF gateway embeddinggemma-2, needs HIP_API_KEY) | openai (needs balance)
EMBEDDING_BACKEND=local
PORT=8001
# LLM backend: claude (Anthropic, structured outputs) | hip (JAIF gateway GLM-5.3-Flash, OpenAI-compatible JSON)
LLM_BACKEND=claude
